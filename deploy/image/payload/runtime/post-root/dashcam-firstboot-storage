#!/bin/sh
# Exact-image, exact-card post-root storage reconciler.  The separately
# injected gates are deliberately absent from ordinary/disabled images.
set -efu
umask 077

GATE=/etc/dashcam/firstboot-runtime-v1.enabled
AUTHORIZATION=/etc/dashcam/expendable-card-v1.authorized
CONFIG=/etc/dashcam/firstboot-initramfs-v1.conf
SOURCE_CONTRACT=/etc/dashcam/source-table-v1.sfdisk
TARGET_CONTRACT=/etc/dashcam/target-table-v1.sfdisk
EARLY_DIR=/boot/firmware/dashcam-provision
EARLY_STATE=$EARLY_DIR/initramfs-v1.state
BACKUP_MBR=$EARLY_DIR/source-first-sector-v1.bin
BACKUP_TABLE=$EARLY_DIR/source-table-v1.sfdisk
BACKUP_SHA=$EARLY_DIR/source-backup-v1.sha256
STATE_DIR=/var/lib/dashcam/provisioning
POST_STATE=$STATE_DIR/post-root-v1.state
PREWIPE=$STATE_DIR/pre-wipe-signatures-v1.txt
ROOT_MARKER=$STATE_DIR/layout-v1.complete.json
STORAGE_ENV=/etc/dashcam/storage-volume.env
MOUNT_POINT=/srv/dashcam
SENTINEL=$MOUNT_POINT/.dashcam-volume
WORK=/run/dashcam-firstboot-post-root
EXPECTED_CID=fe34325344000000200000031a0192d1
EXPECTED_DISK_SECTORS=61440000
EXPECTED_BOOT_PARTUUID=4f2c9ea0-01
EXPECTED_ROOT_PARTUUID=4f2c9ea0-02
EXPECTED_DATA_PARTUUID=4f2c9ea0-03
EXPECTED_BOOT_UUID=89F4-4546
EXPECTED_ROOT_UUID=e9ef4083-101b-46b4-b87d-de84fe1169f8
EXPECTED_SOURCE_FINGERPRINT=17eee4a5eb7d0641bf6ea6a2013ff5203c09aa72b7420ff990bd82ec08406ae6
EXPECTED_CONFIG='schema=v1
disk=/dev/mmcblk0
root=/dev/mmcblk0p2
cid=fe34325344000000200000031a0192d1
device_sectors=61440000
boot_partuuid=4f2c9ea0-01
root_partuuid=4f2c9ea0-02
source_root_sectors=4161536
target_root_sectors=12582912
data_start_sector=13647872
data_size_sectors=47790080'
EXPECTED_SOURCE_TABLE='label:dos
label-id:0x4f2c9ea0
device:/dev/mmcblk0
unit:sectors
sector-size:512
/dev/mmcblk0p1:start=16384,size=1048576,type=c
/dev/mmcblk0p2:start=1064960,size=4161536,type=83'
EXPECTED_TARGET_TABLE='label:dos
label-id:0x4f2c9ea0
device:/dev/mmcblk0
unit:sectors
sector-size:512
/dev/mmcblk0p1:start=16384,size=1048576,type=c
/dev/mmcblk0p2:start=1064960,size=12582912,type=83
/dev/mmcblk0p3:start=13647872,size=47790080,type=7'
EXPECTED_AUTHORIZATION='schema=v1
cid=fe34325344000000200000031a0192d1
device_sectors=61440000'
BACKUP_MANIFEST_HASH=
DATA_UUID=
DASHCAM_UID=
STORAGE_GID=
MOUNTED_BY_US=0
POST_PHASE=none
POST_DATA_UUID=

refuse()
{
    printf '%s\n' "dashcam post-root refused: $*" >&2
    exit 125
}

cleanup()
{
    if [ "$MOUNTED_BY_US" -eq 1 ]; then
        /usr/bin/timeout 15 /usr/bin/umount "$MOUNT_POINT" >/dev/null 2>&1 || :
        MOUNTED_BY_US=0
    fi
}

trap cleanup EXIT HUP INT TERM

bounded_sync()
{
    /usr/bin/timeout 30 /usr/bin/sync ||
        refuse "durable sync timed out or failed"
}

require_regular_exact()
{
    [ -f "$1" ] && [ ! -L "$1" ] ||
        refuse "required regular file is absent or unsafe: $1"
    [ "$(/usr/bin/timeout 10 /usr/bin/readlink -f "$1")" = "$1" ] ||
        refuse "required file does not resolve exactly: $1"
    file_size=$(/usr/bin/timeout 10 /usr/bin/wc -c < "$1") ||
        refuse "cannot size required file: $1"
    case "$file_size" in
    ""|*[!0-9]*)
        refuse "required file size is malformed: $1"
        ;;
    esac
    [ "$file_size" -le 8192 ] || refuse "required file is too large: $1"
}

normalize_table()
{
    /usr/bin/timeout 10 /usr/bin/sed \
        -e '/^[[:space:]]*$/d' -e 's/[[:space:]]//g' "$1"
}

require_exact_contents()
{
    exact_path=$1
    exact_text=$2
    exact_description=$3
    expected_contract=$WORK/contract.expected
    printf '%s\n' "$exact_text" > "$expected_contract" ||
        refuse "cannot prepare exact $exact_description comparison"
    /usr/bin/timeout 10 /usr/bin/cmp -s "$exact_path" "$expected_contract" ||
        refuse "$exact_description contents changed"
}

hash_file()
{
    /usr/bin/timeout 15 /usr/bin/sha256sum "$1" |
        /usr/bin/timeout 10 /usr/bin/cut -d ' ' -f 1
}

durable_replace()
{
    destination=$1
    expected=$2
    temporary=$destination.tmp
    if [ -e "$temporary" ]; then
        [ -f "$temporary" ] && [ ! -L "$temporary" ] ||
            refuse "durable temporary file is unsafe: $temporary"
        /usr/bin/timeout 10 /usr/bin/cmp -s "$temporary" "$expected" ||
            refuse "durable temporary file contradicts the retried write: $temporary"
    else
        (
            set -C
            exec 3> "$temporary"
            /usr/bin/timeout 10 /usr/bin/cat "$expected" >&3
            exec 3>&-
        ) || refuse "cannot create exclusive durable temporary file: $temporary"
    fi
    bounded_sync
    /usr/bin/timeout 10 /usr/bin/mv "$temporary" "$destination" ||
        refuse "cannot atomically replace $destination"
    bounded_sync
    /usr/bin/timeout 10 /usr/bin/cmp -s "$destination" "$expected" ||
        refuse "durable replacement did not read back exactly: $destination"
}

write_text_durably()
{
    destination=$1
    text_value=$2
    expected=$WORK/expected-write
    printf '%s\n' "$text_value" > "$expected" ||
        refuse "cannot prepare bounded durable content"
    durable_replace "$destination" "$expected"
}

validate_contracts()
{
    require_regular_exact "$GATE"
    require_exact_contents "$GATE" EXACT_IMAGE_RUNTIME_VALIDATED=v1 \
        "exact-image runtime gate"
    require_regular_exact "$CONFIG"
    require_exact_contents "$CONFIG" "$EXPECTED_CONFIG" "initramfs configuration"
    require_regular_exact "$SOURCE_CONTRACT"
    require_exact_contents "$SOURCE_CONTRACT" \
        "label: dos
label-id: 0x4f2c9ea0
device: /dev/mmcblk0
unit: sectors
sector-size: 512

/dev/mmcblk0p1 : start=16384, size=1048576, type=c
/dev/mmcblk0p2 : start=1064960, size=4161536, type=83" \
        "source table contract"
    [ "$(normalize_table "$SOURCE_CONTRACT")" = "$EXPECTED_SOURCE_TABLE" ] ||
        refuse "exact source table contract changed"
    require_regular_exact "$TARGET_CONTRACT"
    require_exact_contents "$TARGET_CONTRACT" \
        "label: dos
label-id: 0x4f2c9ea0
device: /dev/mmcblk0
unit: sectors
sector-size: 512

/dev/mmcblk0p1 : start=16384, size=1048576, type=c
/dev/mmcblk0p2 : start=1064960, size=12582912, type=83
/dev/mmcblk0p3 : start=13647872, size=47790080, type=7" \
        "target table contract"
    [ "$(normalize_table "$TARGET_CONTRACT")" = "$EXPECTED_TARGET_TABLE" ] ||
        refuse "exact target table contract changed"
}

validate_authorization()
{
    require_regular_exact "$AUTHORIZATION"
    require_exact_contents "$AUTHORIZATION" "$EXPECTED_AUTHORIZATION" \
        "exact-card destructive authorization"
}

validate_early_state()
{
    require_regular_exact "$EARLY_STATE"
    [ "$(/usr/bin/timeout 10 /usr/bin/wc -l < "$EARLY_STATE")" = 5 ] ||
        refuse "early journal must contain exactly five lines"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc 'phase=early_complete' "$EARLY_STATE")" = 1 ] ||
        refuse "early journal is not complete"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "cid=$EXPECTED_CID" "$EARLY_STATE")" = 1 ] ||
        refuse "early journal CID binding changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "sectors=$EXPECTED_DISK_SECTORS" "$EARLY_STATE")" = 1 ] ||
        refuse "early journal capacity binding changed"
    reboot_count=$(
        /usr/bin/timeout 10 /usr/bin/sed -n 's/^reboot_count=//p' "$EARLY_STATE"
    )
    case "$reboot_count" in
    0|1)
        ;;
    *)
        refuse "early journal reboot count is invalid"
        ;;
    esac
    BACKUP_MANIFEST_HASH=$(
        /usr/bin/timeout 10 /usr/bin/sed -n \
            's/^backup_manifest_sha256=//p' "$EARLY_STATE"
    )
    printf '%s\n' "$BACKUP_MANIFEST_HASH" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9a-f]{64}$' ||
        refuse "early journal backup digest is malformed"
}

manifest_digest_for()
{
    basename_value=$1
    /usr/bin/timeout 10 /usr/bin/sed -n \
        "\\|[[:space:]][ *].*/$basename_value\$|s/[[:space:]].*//p" "$BACKUP_SHA"
}

validate_backups()
{
    require_regular_exact "$BACKUP_MBR"
    require_regular_exact "$BACKUP_TABLE"
    require_regular_exact "$BACKUP_SHA"
    [ "$(/usr/bin/timeout 10 /usr/bin/wc -c < "$BACKUP_MBR")" = 512 ] ||
        refuse "source MBR backup has the wrong size"
    [ "$(hash_file "$BACKUP_SHA")" = "$BACKUP_MANIFEST_HASH" ] ||
        refuse "source backup manifest no longer matches the early journal"
    mbr_manifest=$(manifest_digest_for source-first-sector-v1.bin)
    table_manifest=$(manifest_digest_for source-table-v1.sfdisk)
    printf '%s\n' "$mbr_manifest" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9a-f]{64}$' ||
        refuse "source MBR backup is not uniquely represented in its manifest"
    printf '%s\n' "$table_manifest" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9a-f]{64}$' ||
        refuse "source table backup is not uniquely represented in its manifest"
    [ "$(hash_file "$BACKUP_MBR")" = "$mbr_manifest" ] ||
        refuse "source MBR backup digest changed"
    [ "$(hash_file "$BACKUP_TABLE")" = "$table_manifest" ] ||
        refuse "source table backup digest changed"
    [ "$(normalize_table "$BACKUP_TABLE")" = "$EXPECTED_SOURCE_TABLE" ] ||
        refuse "durable backup is not the exact source table"
}

validate_identity_and_target()
{
    root_source=$(
        /usr/bin/timeout 10 /usr/bin/findmnt -n -o SOURCE --target /
    ) || refuse "cannot resolve the live root source"
    root_source=$(/usr/bin/timeout 10 /usr/bin/readlink -f "$root_source") ||
        refuse "cannot canonicalize the live root source"
    [ "$root_source" = /dev/mmcblk0p2 ] ||
        refuse "live root is not the exact card root partition"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0/device/cid)" = "$EXPECTED_CID" ] ||
        refuse "card CID changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0/size)" = "$EXPECTED_DISK_SECTORS" ] ||
        refuse "card capacity changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0p2/start)" = 1064960 ] ||
        refuse "root start changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0p2/size)" = 12582912 ] ||
        refuse "root size is not the exact 6 GiB target"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0p3/start)" = 13647872 ] ||
        refuse "data start changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat /sys/class/block/mmcblk0p3/size)" = 47790080 ] ||
        refuse "data size changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s PARTUUID -o value /dev/mmcblk0p1)" = "$EXPECTED_BOOT_PARTUUID" ] ||
        refuse "boot PARTUUID changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s PARTUUID -o value /dev/mmcblk0p2)" = "$EXPECTED_ROOT_PARTUUID" ] ||
        refuse "root PARTUUID changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s PARTUUID -o value /dev/mmcblk0p3)" = "$EXPECTED_DATA_PARTUUID" ] ||
        refuse "data PARTUUID changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s UUID -o value /dev/mmcblk0p1)" = "$EXPECTED_BOOT_UUID" ] ||
        refuse "boot filesystem UUID changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s UUID -o value /dev/mmcblk0p2)" = "$EXPECTED_ROOT_UUID" ] ||
        refuse "root filesystem UUID changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s TYPE -o value /dev/mmcblk0p1)" = vfat ] ||
        refuse "boot filesystem type changed"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s TYPE -o value /dev/mmcblk0p2)" = ext4 ] ||
        refuse "root filesystem type changed"
    actual_table=$WORK/actual-table.sfdisk
    /usr/bin/timeout 15 /usr/sbin/sfdisk --dump /dev/mmcblk0 > "$actual_table" ||
        refuse "cannot dump exact target table"
    [ "$(normalize_table "$actual_table")" = "$EXPECTED_TARGET_TABLE" ] ||
        refuse "partition table is not the exact target geometry"
    if /usr/bin/timeout 10 /usr/bin/findmnt -n --source /dev/mmcblk0p3 >/dev/null 2>&1; then
        refuse "data partition is already mounted"
    fi
}

ensure_accounts()
{
    [ -x /usr/sbin/groupadd ] && [ -x /usr/sbin/useradd ] &&
        [ -x /usr/sbin/usermod ] && [ -x /usr/sbin/nologin ] ||
        refuse "required system-account tools are absent"
    if ! /usr/bin/timeout 10 /usr/bin/getent group dashcam >/dev/null; then
        /usr/bin/timeout 20 /usr/sbin/groupadd --system dashcam ||
            refuse "cannot create the dashcam system group"
    fi
    if ! /usr/bin/timeout 10 /usr/bin/getent group dashcam-storage >/dev/null; then
        /usr/bin/timeout 20 /usr/sbin/groupadd --system dashcam-storage ||
            refuse "cannot create the dashcam-storage system group"
    fi
    dashcam_group_gid=$(
        /usr/bin/timeout 10 /usr/bin/getent group dashcam |
            /usr/bin/timeout 10 /usr/bin/cut -d: -f3
    )
    STORAGE_GID=$(
        /usr/bin/timeout 10 /usr/bin/getent group dashcam-storage |
            /usr/bin/timeout 10 /usr/bin/cut -d: -f3
    )
    case "$dashcam_group_gid:$STORAGE_GID" in
    *[!0-9:]*|:*|*:)
        refuse "declared group numeric identities are malformed"
        ;;
    esac
    [ "$dashcam_group_gid" -gt 0 ] && [ "$dashcam_group_gid" -le 999 ] &&
        [ "$STORAGE_GID" -gt 0 ] && [ "$STORAGE_GID" -le 999 ] ||
        refuse "declared groups are not system-group identities"
    if ! /usr/bin/timeout 10 /usr/bin/getent passwd dashcam >/dev/null; then
        /usr/bin/timeout 20 /usr/sbin/useradd --system \
            --gid dashcam --groups dashcam-storage --no-create-home \
            --home-dir /nonexistent --shell /usr/sbin/nologin dashcam ||
            refuse "cannot create the dashcam system user"
    fi
    passwd_entry=$(/usr/bin/timeout 10 /usr/bin/getent passwd dashcam) ||
        refuse "cannot resolve the dashcam system user"
    DASHCAM_UID=$(printf '%s\n' "$passwd_entry" | /usr/bin/timeout 10 /usr/bin/cut -d: -f3)
    primary_gid=$(printf '%s\n' "$passwd_entry" | /usr/bin/timeout 10 /usr/bin/cut -d: -f4)
    home_dir=$(printf '%s\n' "$passwd_entry" | /usr/bin/timeout 10 /usr/bin/cut -d: -f6)
    login_shell=$(printf '%s\n' "$passwd_entry" | /usr/bin/timeout 10 /usr/bin/cut -d: -f7)
    case "$DASHCAM_UID:$primary_gid" in
    *[!0-9:]*|:*|*:)
        refuse "dashcam numeric user identity is malformed"
        ;;
    esac
    [ "$DASHCAM_UID" -gt 0 ] && [ "$DASHCAM_UID" -le 999 ] ||
        refuse "dashcam is not a system-user identity"
    [ "$primary_gid" = "$dashcam_group_gid" ] &&
        [ "$home_dir" = /nonexistent ] &&
        [ "$login_shell" = /usr/sbin/nologin ] ||
        refuse "existing dashcam user conflicts with the closed service identity"
    dashcam_groups=$(/usr/bin/timeout 10 /usr/bin/id -G dashcam) ||
        refuse "cannot resolve dashcam supplementary groups"
    storage_member=0
    for numeric_gid in $dashcam_groups; do
        [ "$numeric_gid" = "$STORAGE_GID" ] && storage_member=1
    done
    if [ "$storage_member" -ne 1 ]; then
        /usr/bin/timeout 20 /usr/sbin/usermod -a -G dashcam-storage dashcam ||
            refuse "cannot add dashcam to its recording-storage group"
        dashcam_groups=$(/usr/bin/timeout 10 /usr/bin/id -G dashcam) ||
            refuse "cannot re-resolve dashcam supplementary groups"
        storage_member=0
        for numeric_gid in $dashcam_groups; do
            [ "$numeric_gid" = "$STORAGE_GID" ] && storage_member=1
        done
        [ "$storage_member" -eq 1 ] ||
            refuse "dashcam storage-group membership did not take effect"
    fi
}

sentinel_payload()
{
    printf '%s\n' \
        "{\"layout_version\":1,\"serial\":\"$EXPECTED_CID\",\"dashcam_uuid\":\"$1\",\"source_table_fingerprint\":\"$EXPECTED_SOURCE_FINGERPRINT\",\"root_end_sector\":13647871,\"data_start_sector\":13647872,\"data_end_sector\":61437951}"
}

validate_identity_payload()
{
    payload_path=$1
    payload_uuid=$2
    require_regular_exact "$payload_path"
    [ "$(/usr/bin/timeout 10 /usr/bin/cat "$payload_path")" = "$(sentinel_payload "$payload_uuid")" ] ||
        refuse "identity marker does not exactly bind this transaction: $payload_path"
}

capture_signatures()
{
    signatures=$1
    /usr/bin/timeout 15 /usr/sbin/wipefs --no-act --noheadings \
        --output TYPE,OFFSET /dev/mmcblk0p3 > "$signatures" ||
        refuse "bounded signature scan failed"
    signature_size=$(/usr/bin/timeout 10 /usr/bin/wc -c < "$signatures") ||
        refuse "cannot size signature evidence"
    [ "$signature_size" -le 4096 ] || refuse "signature evidence exceeds its bound"
}

record_signatures()
{
    signatures=$WORK/pre-wipe-signatures.txt
    capture_signatures "$signatures"
    if [ -e "$PREWIPE" ]; then
        require_regular_exact "$PREWIPE"
        /usr/bin/timeout 10 /usr/bin/cmp -s "$PREWIPE" "$signatures" ||
            refuse "current signatures contradict durable pre-wipe evidence"
    else
        durable_replace "$PREWIPE" "$signatures"
    fi
}

write_post_state()
{
    phase_value=$1
    uuid_value=$2
    write_text_durably "$POST_STATE" "phase=$phase_value
cid=$EXPECTED_CID
sectors=$EXPECTED_DISK_SECTORS
backup_manifest_sha256=$BACKUP_MANIFEST_HASH
data_uuid=$uuid_value
source_table_fingerprint=$EXPECTED_SOURCE_FINGERPRINT"
}

load_post_state()
{
    if [ ! -e "$POST_STATE" ]; then
        POST_PHASE=none
        POST_DATA_UUID=
        return 0
    fi
    require_regular_exact "$POST_STATE"
    [ "$(/usr/bin/timeout 10 /usr/bin/wc -l < "$POST_STATE")" = 6 ] ||
        refuse "post-root journal must contain exactly six lines"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "cid=$EXPECTED_CID" "$POST_STATE")" = 1 ] ||
        refuse "post-root journal CID binding changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "sectors=$EXPECTED_DISK_SECTORS" "$POST_STATE")" = 1 ] ||
        refuse "post-root journal capacity binding changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "backup_manifest_sha256=$BACKUP_MANIFEST_HASH" "$POST_STATE")" = 1 ] ||
        refuse "post-root journal backup binding changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/grep -Fxc "source_table_fingerprint=$EXPECTED_SOURCE_FINGERPRINT" "$POST_STATE")" = 1 ] ||
        refuse "post-root journal source-table binding changed"
    POST_PHASE=$(
        /usr/bin/timeout 10 /usr/bin/sed -n 's/^phase=//p' "$POST_STATE"
    )
    POST_DATA_UUID=$(
        /usr/bin/timeout 10 /usr/bin/sed -n 's/^data_uuid=//p' "$POST_STATE"
    )
    case "$POST_PHASE" in
    format_intent)
        [ "$POST_DATA_UUID" = none ] ||
            refuse "format-intent journal unexpectedly contains a data UUID"
        ;;
    formatted|sentinel_durable|complete)
        printf '%s\n' "$POST_DATA_UUID" |
            /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$' ||
            refuse "post-root journal data UUID is malformed"
        ;;
    *)
        refuse "post-root journal phase is invalid"
        ;;
    esac
}

require_format_recovery_binding()
{
    validate_authorization
    require_regular_exact "$PREWIPE"
    case "$POST_PHASE" in
    format_intent)
        DATA_UUID=$observed_uuid
        write_post_state formatted "$DATA_UUID"
        POST_PHASE=formatted
        POST_DATA_UUID=$DATA_UUID
        ;;
    formatted)
        [ "$POST_DATA_UUID" = "$observed_uuid" ] ||
            refuse "formatted journal UUID does not match the existing exFAT volume"
        ;;
    *)
        refuse "existing formatted volume lacks an exact creation journal"
        ;;
    esac
}

mount_and_verify()
{
    mount_options="rw,noatime,nosuid,nodev,noexec,uid=$DASHCAM_UID,gid=$STORAGE_GID,umask=0007"
    /usr/bin/timeout 10 /usr/bin/mkdir -p "$MOUNT_POINT" ||
        refuse "cannot create the closed recording mount point"
    [ -d "$MOUNT_POINT" ] && [ ! -L "$MOUNT_POINT" ] ||
        refuse "recording mount point is unsafe"
    /usr/bin/timeout 120 /usr/sbin/fsck.exfat -n /dev/mmcblk0p3 >/dev/null ||
        refuse "read-only exFAT check failed"
    /usr/bin/timeout 20 /usr/bin/mount -t exfat -o "$mount_options" \
        "UUID=$DATA_UUID" "$MOUNT_POINT" ||
        refuse "cannot mount exact recording volume"
    MOUNTED_BY_US=1
    mounted_source=$(
        /usr/bin/timeout 10 /usr/bin/findmnt -n -o SOURCE --target "$MOUNT_POINT"
    ) || refuse "cannot verify mounted recording source"
    mounted_source=$(/usr/bin/timeout 10 /usr/bin/readlink -f "$mounted_source") ||
        refuse "cannot canonicalize mounted recording source"
    [ "$mounted_source" = /dev/mmcblk0p3 ] ||
        refuse "mounted recording source changed"
    [ "$(/usr/bin/timeout 10 /usr/bin/findmnt -n -o FSTYPE --target "$MOUNT_POINT")" = exfat ] ||
        refuse "mounted recording filesystem is not exFAT"
    mounted_options=$(
        /usr/bin/timeout 10 /usr/bin/findmnt -n -o OPTIONS --target "$MOUNT_POINT"
    ) || refuse "cannot read effective recording mount options"
    for required_option in rw noatime nosuid nodev noexec "uid=$DASHCAM_UID" "gid=$STORAGE_GID"; do
        printf '%s\n' "$mounted_options" |
            /usr/bin/timeout 10 /usr/bin/grep -Eq "(^|,)$required_option(,|$)" ||
            refuse "effective recording mount lacks $required_option"
    done
    if ! printf '%s\n' "$mounted_options" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '(^|,)umask=0007(,|$)'; then
        printf '%s\n' "$mounted_options" |
            /usr/bin/timeout 10 /usr/bin/grep -Eq '(^|,)fmask=0007(,|$)' &&
            printf '%s\n' "$mounted_options" |
                /usr/bin/timeout 10 /usr/bin/grep -Eq '(^|,)dmask=0007(,|$)' ||
            refuse "effective recording mount lacks the exact 0007 mask"
    fi
    write_probe=$MOUNT_POINT/.dashcam-firstboot-write-test
    (
        set -C
        printf '%s\n' dashcam-firstboot-write-test > "$write_probe"
    ) || refuse "recording volume is not exclusively writable"
    bounded_sync
    /usr/bin/timeout 10 /usr/bin/rm -f "$write_probe" ||
        refuse "cannot remove recording-volume write probe"
    bounded_sync
}

install_fstab()
{
    fstab_line="UUID=$DATA_UUID /srv/dashcam exfat noatime,nosuid,nodev,noexec,uid=$DASHCAM_UID,gid=$STORAGE_GID,umask=0007,nofail,x-systemd.device-timeout=10s 0 0"
    exact_count=$(
        /usr/bin/timeout 10 /usr/bin/grep -Fxc "$fstab_line" /etc/fstab || :
    )
    target_count=$(
        /usr/bin/timeout 10 /usr/bin/awk '
            $0 !~ /^[[:space:]]*#/ && NF >= 2 && $2 == "/srv/dashcam" { count++ }
            END { print count + 0 }
        ' /etc/fstab
    )
    if [ "$exact_count" -eq 1 ] && [ "$target_count" -eq 1 ]; then
        return 0
    fi
    [ "$exact_count" -eq 0 ] && [ "$target_count" -eq 0 ] ||
        refuse "/etc/fstab contains a conflicting recording mount"
    expected_fstab=$WORK/fstab.expected
    /usr/bin/timeout 10 /usr/bin/cp --preserve=mode,ownership,timestamps \
        /etc/fstab "$expected_fstab" || refuse "cannot prepare bounded fstab update"
    printf '\n%s\n' "$fstab_line" >> "$expected_fstab" ||
        refuse "cannot append exact fstab entry"
    durable_replace /etc/fstab "$expected_fstab"
}

remove_bounded_trigger()
{
    cmdline=/boot/firmware/cmdline.txt
    require_regular_exact "$cmdline"
    current=$(/usr/bin/timeout 10 /usr/bin/cat "$cmdline") ||
        refuse "cannot read boot command line"
    trigger_count=0
    output=
    for token in $current; do
        if [ "$token" = dashcam.bounded_provision=v1 ]; then
            trigger_count=$((trigger_count + 1))
        else
            if [ -z "$output" ]; then
                output=$token
            else
                output="$output $token"
            fi
        fi
    done
    [ "$trigger_count" -eq 1 ] ||
        refuse "bounded trigger is absent or duplicated at completion"
    write_text_durably "$cmdline" "$output"
}

trigger_count=0
resize_count=0
for token in $(/usr/bin/timeout 10 /usr/bin/cat /proc/cmdline); do
    case "$token" in
    dashcam.bounded_provision=v1)
        trigger_count=$((trigger_count + 1))
        ;;
    resize)
        resize_count=$((resize_count + 1))
        ;;
    esac
done
[ "$trigger_count" -eq 1 ] || refuse "exact bounded trigger is absent or duplicated"
[ "$resize_count" -eq 0 ] || refuse "stock resize trigger is forbidden"

for program in \
    /usr/bin/awk /usr/bin/cat /usr/bin/cmp /usr/bin/cp /usr/bin/cut \
    /usr/bin/findmnt /usr/bin/getent /usr/bin/grep /usr/bin/id /usr/bin/mkdir \
    /usr/bin/mount /usr/bin/mv /usr/bin/readlink /usr/bin/rm /usr/bin/sed \
    /usr/bin/sha256sum /usr/bin/sync /usr/bin/timeout /usr/bin/wc \
    /usr/sbin/blkid /usr/sbin/fsck.exfat /usr/sbin/groupadd /usr/sbin/mkfs.exfat \
    /usr/sbin/sfdisk /usr/sbin/useradd /usr/sbin/usermod /usr/sbin/wipefs; do
    [ -x "$program" ] || refuse "required executable is absent: $program"
done

/usr/bin/timeout 10 /usr/bin/mkdir -p "$WORK" "$STATE_DIR" ||
    refuse "cannot create bounded post-root state directories"
[ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ] ||
    refuse "post-root state directory is unsafe"

validate_contracts
validate_early_state
validate_backups
validate_identity_and_target
load_post_state

data_type=$(
    /usr/bin/timeout 10 /usr/sbin/blkid -s TYPE -o value /dev/mmcblk0p3 || :
)
data_label=$(
    /usr/bin/timeout 10 /usr/sbin/blkid -s LABEL -o value /dev/mmcblk0p3 || :
)
observed_uuid=$(
    /usr/bin/timeout 10 /usr/sbin/blkid -s UUID -o value /dev/mmcblk0p3 || :
)

if [ -n "$data_type" ] || [ -n "$data_label" ] || [ -n "$observed_uuid" ]; then
    [ "$data_type" = exfat ] && [ "$data_label" = DASHCAM ] ||
        refuse "an existing data filesystem is not the exact DASHCAM exFAT volume"
    printf '%s\n' "$observed_uuid" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$' ||
        refuse "existing DASHCAM UUID is malformed"
    DATA_UUID=$observed_uuid
    case "$POST_PHASE" in
    format_intent|formatted)
        require_format_recovery_binding
        ;;
    sentinel_durable|complete)
        [ "$POST_DATA_UUID" = "$DATA_UUID" ] ||
            refuse "post-root journal contradicts the existing exFAT UUID"
        ;;
    none)
        refuse "existing formatted volume lacks an exact creation journal"
        ;;
    *)
        refuse "post-root journal escaped its closed state machine"
        ;;
    esac
    ensure_accounts
    marker_matches=0
    if [ -e "$ROOT_MARKER" ]; then
        validate_identity_payload "$ROOT_MARKER" "$DATA_UUID"
        case "$POST_PHASE" in
        sentinel_durable|complete)
            ;;
        *)
            refuse "root marker contradicts the post-root journal phase"
            ;;
        esac
        marker_matches=1
    elif [ "$POST_PHASE" = complete ]; then
        refuse "complete journal exists without the durable root marker"
    fi
    mount_and_verify
    if [ ! -e "$SENTINEL" ]; then
        [ "$marker_matches" -eq 0 ] ||
            refuse "root marker exists without the volume sentinel"
        [ "$POST_PHASE" = formatted ] ||
            refuse "durable journal claims a missing volume sentinel"
        expected_sentinel=$WORK/sentinel.expected
        sentinel_payload "$DATA_UUID" > "$expected_sentinel" ||
            refuse "cannot prepare recovered volume sentinel"
        durable_replace "$SENTINEL" "$expected_sentinel"
    fi
    validate_identity_payload "$SENTINEL" "$DATA_UUID"
else
    [ ! -e "$ROOT_MARKER" ] ||
        refuse "root marker exists before the data filesystem"
    validate_authorization
    ensure_accounts
    case "$POST_PHASE" in
    none)
        record_signatures
        write_post_state format_intent none
        ;;
    format_intent)
        require_regular_exact "$PREWIPE"
        retry_signatures=$WORK/retry-signatures.txt
        capture_signatures "$retry_signatures"
        if [ -s "$retry_signatures" ]; then
            /usr/bin/timeout 10 /usr/bin/cmp -s "$PREWIPE" "$retry_signatures" ||
                refuse "retry signatures contradict the durable pre-wipe evidence"
        fi
        ;;
    *)
        refuse "post-root journal claims a filesystem phase but no filesystem exists"
        ;;
    esac
    if [ -s "$PREWIPE" ]; then
        /usr/bin/timeout 30 /usr/sbin/wipefs --all /dev/mmcblk0p3 ||
            refuse "bounded signature wipe failed"
    fi
    verify_signatures=$WORK/post-wipe-signatures.txt
    /usr/bin/timeout 15 /usr/sbin/wipefs --no-act --noheadings \
        --output TYPE,OFFSET /dev/mmcblk0p3 > "$verify_signatures" ||
        refuse "post-wipe signature verification failed"
    [ ! -s "$verify_signatures" ] ||
        refuse "recognized signatures remain after the bounded wipe"
    validate_identity_and_target
    /usr/bin/timeout 120 /usr/sbin/mkfs.exfat -L DASHCAM /dev/mmcblk0p3 ||
        refuse "bounded exFAT format failed"
    DATA_UUID=$(
        /usr/bin/timeout 10 /usr/sbin/blkid -s UUID -o value /dev/mmcblk0p3
    ) || refuse "cannot capture the new exFAT UUID"
    [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s TYPE -o value /dev/mmcblk0p3)" = exfat ] &&
        [ "$(/usr/bin/timeout 10 /usr/sbin/blkid -s LABEL -o value /dev/mmcblk0p3)" = DASHCAM ] ||
        refuse "new filesystem identity did not read back exactly"
    printf '%s\n' "$DATA_UUID" |
        /usr/bin/timeout 10 /usr/bin/grep -Eq '^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$' ||
        refuse "new exFAT UUID is malformed"
    write_post_state formatted "$DATA_UUID"
    POST_PHASE=formatted
    POST_DATA_UUID=$DATA_UUID
    mount_and_verify
    expected_sentinel=$WORK/sentinel.expected
    sentinel_payload "$DATA_UUID" > "$expected_sentinel" ||
        refuse "cannot prepare exact volume sentinel"
    durable_replace "$SENTINEL" "$expected_sentinel"
    validate_identity_payload "$SENTINEL" "$DATA_UUID"
fi

for directory in pending clips protected quarantine; do
    /usr/bin/timeout 10 /usr/bin/mkdir -p "$MOUNT_POINT/$directory" ||
        refuse "cannot create closed recording directory: $directory"
done
bounded_sync
case "$POST_PHASE" in
formatted)
    write_post_state sentinel_durable "$DATA_UUID"
    POST_PHASE=sentinel_durable
    POST_DATA_UUID=$DATA_UUID
    ;;
sentinel_durable|complete)
    ;;
*)
    refuse "post-root journal cannot advance after sentinel verification"
    ;;
esac
install_fstab
write_text_durably "$STORAGE_ENV" "DASHCAM_STORAGE_UUID=$DATA_UUID"
expected_marker=$WORK/marker.expected
sentinel_payload "$DATA_UUID" > "$expected_marker" ||
    refuse "cannot prepare exact root completion marker"
durable_replace "$ROOT_MARKER" "$expected_marker"
validate_identity_payload "$ROOT_MARKER" "$DATA_UUID"
validate_identity_payload "$SENTINEL" "$DATA_UUID"
case "$POST_PHASE" in
sentinel_durable)
    write_post_state complete "$DATA_UUID"
    POST_PHASE=complete
    POST_DATA_UUID=$DATA_UUID
    ;;
complete)
    ;;
*)
    refuse "post-root journal cannot advance after marker verification"
    ;;
esac
remove_bounded_trigger
trap - EXIT HUP INT TERM
exit 0
